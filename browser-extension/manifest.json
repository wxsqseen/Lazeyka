{
  "manifest_version": 3,
  "name": "Лазейка — VPN только для браузера",
  "short_name": "Лазейка",
  "version": "1.0.0",
  "description": "Пускает этот браузер через свой VPN Лазейки (режим «Только локальный прокси»). Другие программы и Windows не затрагиваются.",
  "permissions": ["proxy", "storage", "privacy"],
  "host_permissions": ["https://1.1.1.1/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Лазейка",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
