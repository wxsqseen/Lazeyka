{
  "manifest_version": 3,
  "name": "Лазейка — VPN и прокси только для браузера",
  "short_name": "Лазейка",
  "version": "1.1.0",
  "description": "Пускает этот браузер через свой VPN Лазейки или через любой прокси HTTP, HTTPS, SOCKS5 и SOCKS4 — с логином и паролем, без Лазейки. Другие программы и Windows не затрагиваются.",
  "permissions": [
    "proxy",
    "storage",
    "privacy"
  ],
  "optional_permissions": [
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://1.1.1.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Лазейка",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
